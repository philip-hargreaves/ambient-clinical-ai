<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Ambient.App.Views.ReflectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Reflection"
    CloseButtonText="Done"
    DefaultButton="Close"
    Closing="OnClosing">

    <!-- Wider than the stock dialog; content never exceeds it -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">820</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,0">
            <ContentControl x:Name="EditorHost" HorizontalContentAlignment="Stretch" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
