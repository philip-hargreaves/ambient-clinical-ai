<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Ambient.App.Views.DemoTrayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Replay controls: buttons while idle, a transport while replaying, nothing in review -->
    <Grid>
        <StackPanel
            Orientation="Horizontal"
            Spacing="2"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.Idle, Mode=OneWay}">
            <Button
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.PlayCommand}"
                Style="{StaticResource TrayButton}"
                ToolTipService.ToolTip="Replay the selected recording">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource MutedTextBrush}"
                        Text="Replay" />
                </StackPanel>
            </Button>
            <DropDownButton
                VerticalAlignment="Center"
                Style="{StaticResource TrayButton}"
                ToolTipService.ToolTip="Recording to replay">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource MutedTextBrush}"
                    Text="{x:Bind ViewModel.TrackName, Mode=OneWay}" />
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="ReplayFlyout" Placement="BottomEdgeAlignedLeft" />
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.CycleSpeedCommand}"
                Style="{StaticResource TrayButton}"
                ToolTipService.ToolTip="Replay speed; results are only trusted at 1x">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource MutedTextBrush}"
                    Text="{x:Bind ViewModel.SpeedLabel, Mode=OneWay}" />
            </Button>
            <ToggleButton
                VerticalAlignment="Center"
                IsChecked="{x:Bind ViewModel.MonitorAudio, Mode=TwoWay}"
                Style="{StaticResource TrayToggleButton}"
                ToolTipService.ToolTip="Play the recording aloud">
                <FontIcon
                    FontSize="14"
                    Foreground="{ThemeResource MutedTextBrush}"
                    Glyph="{x:Bind ViewModel.MonitorGlyph, Mode=OneWay}" />
            </ToggleButton>
        </StackPanel>

        <StackPanel
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsReplaying, Mode=OneWay}">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource MutedTextBrush}"
                Text="{x:Bind ViewModel.TrackName, Mode=OneWay}" />
            <ProgressBar
                Width="110"
                VerticalAlignment="Center"
                Maximum="1"
                Value="{x:Bind ViewModel.ProgressFraction, Mode=OneWay}" />
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource CaptionText}"
                Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
            <Button
                Command="{x:Bind ViewModel.TogglePauseCommand}"
                Style="{StaticResource TrayButton}"
                ToolTipService.ToolTip="Pause or resume">
                <FontIcon FontSize="13" Glyph="{x:Bind ViewModel.PauseGlyph, Mode=OneWay}" />
            </Button>
            <Button
                Command="{x:Bind ViewModel.StopCommand}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource TrayButton}"
                ToolTipService.ToolTip="Stop and finalise">
                <FontIcon FontSize="13" Glyph="&#xE71A;" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
