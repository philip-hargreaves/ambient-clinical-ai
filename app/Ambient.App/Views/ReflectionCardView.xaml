<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Ambient.App.Views.ReflectionCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="8" Margin="0,0,0,4">
        <!-- The month heads its group -->
        <TextBlock
            Margin="2,10,0,2"
            Foreground="{ThemeResource FaintTextBrush}"
            Style="{ThemeResource BodyStrongTextBlockStyle}"
            Text="{x:Bind Card.MonthLabel, Mode=OneWay}"
            Visibility="{x:Bind Card.StartsMonth, Mode=OneWay}" />

        <Border Style="{StaticResource InnerCardSurface}" Padding="0">
            <StackPanel>
                <!-- Closed: the title and the case study -->
                <Button
                    Padding="16,12"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind Card.ToggleCommand}"
                    Visibility="{x:Bind Collapsed, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind Card.Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource MutedTextBrush}"
                                Text="{x:Bind Card.Line, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <FontIcon
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource FaintTextBrush}"
                            Glyph="&#xE70D;" />
                    </Grid>
                </Button>

                <!-- Open: the header is the editable title, then the editor in place -->
                <StackPanel
                    Padding="16,8,16,14"
                    Spacing="12"
                    Visibility="{x:Bind Card.Expanded, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="TitleBox"
                            AutomationProperties.Name="Reflection title"
                            BorderThickness="0"
                            Background="Transparent"
                            FontSize="18"
                            FontWeight="SemiBold"
                            LostFocus="OnTitleCommitted"
                            Padding="0,4"
                            PlaceholderText="{x:Bind Card.MonthLabel, Mode=OneWay}" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Command="{x:Bind Card.ToggleCommand}"
                            Style="{StaticResource TrayButton}"
                            ToolTipService.ToolTip="Close">
                            <FontIcon FontSize="12" Foreground="{ThemeResource FaintTextBrush}" Glyph="&#xE70E;" />
                        </Button>
                    </Grid>
                    <ContentControl x:Name="EditorHost" HorizontalContentAlignment="Stretch" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
